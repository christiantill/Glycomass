# Local development only; use separate credentials for production.
GLYCOMASS_ENVIRONMENT=development
GLYCOMASS_DATABASE_URL=postgresql+asyncpg://glycomass:glycomass@localhost:5432/glycomass
GLYCOMASS_REDIS_URL=redis://localhost:6379/0
GLYCOMASS_UPLOAD_DIR=data/uploads
GLYCOMASS_RESULT_DIR=data/results
GLYCOMASS_MAX_UPLOAD_BYTES=262144000

# Warn for algorithm phases taking at least this many milliseconds.
# GLYCOMASS_LOG_LEVEL=DEBUG also emits faster phase timings.
GLYCOMASS_SLOW_OPERATION_MS=1000
